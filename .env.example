# BorrowHub Environment Variables
PORT=5000

# Cloud MySQL Database Configuration (Aiven / TiDB Cloud / Railway / PlanetScale)
DB_HOST=your-mysql-host.aivencloud.com
DB_PORT=3306
DB_USER=avnadmin
DB_PASSWORD=your_db_password
DB_NAME=borrowhub
DB_SSL=true

# Alternatively, provide a full MySQL connection URL:
# DATABASE_URL=mysql://user:password@host:3306/borrowhub
